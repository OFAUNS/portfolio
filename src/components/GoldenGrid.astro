---
import {
    buildGoldenCells,
    buildGoldenSpiral,
    resolvePreset,
    SPIRAL_VIEWBOX,
} from "@/lib/goldenGrid";

interface Props {
    /** GOLDEN_PRESETS 的鍵，決定這一頁的格線個性。 */
    preset?: string;
    /** 這一頁的重點色，格線、弧線與水波都會吃這個值。 */
    accent?: string;
}

const { preset: presetName = "minimal", accent = "#5ddcff" } = Astro.props;
const preset = resolvePreset(presetName);
const cells = buildGoldenCells(preset);
const arcs = buildGoldenSpiral(cells);

/** 整段進程的長度。弧線在這個時間內畫完，方格也依序點亮。 */
const PROGRESS_MS = 5000;
const step = PROGRESS_MS / Math.max(cells.length, 1);

// 水波 canvas 是 fixed 全視窗的，要把它掃過每一格就得換算回視窗座標。
// clip-path 的四個值是「距離該邊多遠」，所以右／下要用視窗尺寸倒扣。
const clipFor = (cell: (typeof cells)[number]) => {
    const x = (cell.x / 100).toFixed(5);
    const y = (cell.y / 100).toFixed(5);
    const s = (cell.size / 100).toFixed(5);
    return (
        `inset(` +
        `calc(var(--gg-y) + var(--gg-h) * ${y}) ` +
        `calc(100vw - var(--gg-x) - var(--gg-w) * ${(cell.x / 100 + cell.size / 100).toFixed(5)}) ` +
        `calc(100vh - var(--gg-y) - var(--gg-h) * ${y} - var(--gg-w) * ${s}) ` +
        `calc(var(--gg-x) + var(--gg-w) * ${x}))`
    );
};

// 逐頁產生水波掃描的 keyframes：每一格佔一個時段，時段內停住、切換時跳到下一格。
const sweepName = `gg-water-sweep-${presetName}`;
const sweepFrames = cells
    .map((cell, index) => {
        const from = ((index / cells.length) * 100).toFixed(3);
        const to = (((index + 1) / cells.length) * 100 - 0.001).toFixed(3);
        return `${from}%,${to}%{clip-path:${clipFor(cell)}}`;
    })
    .join("");

const pageStyle =
    `:root{--gg-accent:${accent};--gg-progress:${PROGRESS_MS}ms}` +
    `@keyframes ${sweepName}{${sweepFrames}}` +
    `#water-field{animation:${sweepName} var(--gg-progress) steps(1,end) 1 both,`
    + `gg-water-settle var(--gg-progress) ease-out 1 both;`
    + `clip-path:${clipFor(cells[0])}}`;
---

<style is:global set:html={pageStyle}></style>

<div class="golden-grid" data-preset={presetName} aria-hidden="true">
    {
        cells.map((cell) => (
            <div
                class:list={["golden-cell", `golden-cell--${cell.role}`]}
                data-index={cell.index}
                style={`left:${cell.x}%;top:${cell.y}%;width:${cell.size}%;--gg-delay:${(cell.index * step).toFixed(0)}ms;--gg-step:${step.toFixed(0)}ms;view-transition-name:${cell.id};`}
            >
                <span class="golden-cell__edge" />
                <span class="golden-cell__wave" />
                <span class="golden-cell__tick">{String(cell.index + 1).padStart(2, "0")}</span>
            </div>
        ))
    }

    <svg
        class="golden-spiral"
        viewBox={`0 0 ${SPIRAL_VIEWBOX.w} ${SPIRAL_VIEWBOX.h}`}
        preserveAspectRatio="none"
        fill="none"
    >
        {
            arcs.map((arc) => (
                <path
                    class="golden-spiral__arc"
                    d={arc.d}
                    style={`--arc-len:${arc.length.toFixed(1)};--gg-delay:${(arc.index * step).toFixed(0)}ms;--gg-step:${step.toFixed(0)}ms;`}
                />
            ))
        }
    </svg>
</div>
