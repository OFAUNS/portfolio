---
import Layout from "@/layouts/Layout.astro";
import ResponsiveImage from "@/components/ResponsiveImage.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";

const PROFILE = {
    name: "OFANUS",
    cnName: "陳昱洋",
    enName: "CHEN, YU-YUNG",
    role: "Creative Designer & Developer",
    phone: "0901267387",
    email: "cheny4314@gmail.com",
    bio: "Passionate about creating beautiful and functional digital experiences through design, development, and innovative digital solutions.",
    avatar: "/header.jpg",
    links: {
        email: "mailto:cheny4314@gmail.com",
        phone: "tel:0901267387",
    },
};

const EDUCATION = {
    school: "Yuan Ze University",
    cnSchool: "元智大學",
    major: "Information Communication",
    cnMajor: "資訊傳播學系",
    startYear: 2023,
};

const SKILLS = {
    programming: ["C++", "Java", "JavaScript", "C#", "HTML"],
    tools: ["Unity", "Phaser", "Touch Designer", "DaVinci", "Blender", "n8n"],
    softSkills: ["Project Management", "Proposal Skills", "UX Research", "Team Coordination"],
};

type ExperienceItem = {
    title: string;
    cnTitle?: string;
    date: string;
    company?: string;
    event?: string;
    description: string;
    details: string[];
};

// 沿用作品案例頁的主題色變數，讓 About 吃到同一套 .work-case 視覺語彙
const caseStyle = "--case-accent: #5ddcff; --case-accent-2: #d8ff38;";

const EXPERIENCE: ExperienceItem[] = [
    {
        title: "Enterprise Information Session Coordinator",
        cnTitle: "企業說明會總召",
        date: "2026/03",
        company: "Pacific Cable, Chao Mei Microcomputer",
        description: "Served as event coordinator for enterprise information sessions. Managed vendor partnerships, organized event logistics, and coordinated staff assignments to ensure smooth event execution.",
        details: ["Coordinated with vendor partners", "Planned and organized event layout", "Managed team assignments and logistics"]
    },
    {
        title: "Paper Presentation",
        cnTitle: "論文發表",
        date: "2026/02",
        event: "TWELF2026 - 21st Taiwan Digital Learning Development Symposium",
        description: "In-depth research and data analysis on cryptography education. Presented findings to professors and graduate students.",
        details: ["Conducted deep data analysis on cryptography education", "Wrote comprehensive research paper", "Presented to academic professionals"]
    },
    {
        title: "Escape Room Front Desk & NPC",
        cnTitle: "密室逃脫前台&NPC",
        date: "2025/03 - 2025/10",
        description: "Managed front desk operations and provided immersive NPC experience. Designed escape room scenarios and observed user experience.",
        details: ["Mastered customer service protocols and presentation", "Designed immersive room scenarios", "Observed and analyzed user experience"]
    },
    {
        title: "Video Marketing",
        cnTitle: "影片行銷",
        date: "2025/09 - 2026/01",
        description: "Produced and directed marketing videos. Conducted on-site research and scriptwriting. Ranked first among project submissions.",
        details: ["Proficiently operated professional studio equipment and LED walls", "Conducted field research and cultural immersion", "Authored scripts and achieved top project ranking"]
    },
    {
        title: "AI Cryptography Learning Game Development",
        cnTitle: "三重鷹架Phaser網頁密碼學劇情解謎手機遊戲",
        date: "2025/07 - 2025/09",
        description: "Led game development as Project Manager. Built game architecture using Phaser + React.js framework. Integrated AI virtual character to assist student learning through gamified puzzle-solving.",
        details: ["Managed programming and art direction", "Architected game structure with Phaser and React.js", "Implemented AI-assisted learning mechanics"]
    }
];
---

<Layout title="About OFANUS" description="About page" grid="about" accent="#9ff3d1">
    <article class="work-case case-layout-about" style={caseStyle} data-layout="about">
        <header class="case-nav">
            <a href="/" class="case-back-link" aria-label="Back to works">
                <span class="case-back-icon" aria-hidden="true">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="m12 19-7-7 7-7"></path>
                        <path d="M19 12H5"></path>
                    </svg>
                </span>
                <span>Works</span>
            </a>
            <ThemeToggle />
        </header>

        <main class="case-shell animate-blur-in">
            <section class="case-hero">
                <div class="case-hero-copy">
                    <p class="case-kicker portfolio-text-wipe delay-100">{PROFILE.enName}</p>
                    <h1 class="case-title portfolio-text-wipe portfolio-text-wipe--title delay-200">
                        <span>{PROFILE.name}</span>
                    </h1>
                    <p class="case-summary portfolio-text-wipe delay-300">{PROFILE.bio}</p>

                    <div class="case-quick-meta animate-blur-in delay-400" aria-label="Profile summary">
                        <span>{PROFILE.cnName}</span>
                        <span>{PROFILE.role}</span>
                    </div>
                </div>

                <div class="case-media-frame" data-fit="cover">
                    <div class="case-media-topline">
                        <span>Profile</span>
                        <span>{EDUCATION.cnSchool}</span>
                    </div>
                    <div class="case-media-surface">
                        <ResponsiveImage
                            src={PROFILE.avatar}
                            alt={`${PROFILE.name} 個人照`}
                            class="case-hero-image"
                            decoding="async"
                            fetchpriority="high"
                            loading="eager"
                            sizes="(max-width: 900px) 92vw, 44vw"
                        />
                    </div>
                </div>
            </section>

            <section class="case-content-section">
                <div class="case-section-heading">
                    <p>Contact</p>
                    <h2>聯絡方式</h2>
                </div>
                <div class="about-panel-list">
                    <a class="about-panel about-panel--link" href={PROFILE.links.phone}>
                        <span>Phone</span>
                        <strong>{PROFILE.phone}</strong>
                    </a>
                    <a class="about-panel about-panel--link" href={PROFILE.links.email}>
                        <span>Email</span>
                        <strong>{PROFILE.email}</strong>
                    </a>
                </div>
            </section>

            <section class="case-content-section">
                <div class="case-section-heading">
                    <p>Education</p>
                    <h2>學歷</h2>
                </div>
                <div class="about-panel-list">
                    <div class="about-panel">
                        <span>Since {EDUCATION.startYear}</span>
                        <strong>{EDUCATION.school}</strong>
                        <p>{EDUCATION.cnSchool}</p>
                        <p>{EDUCATION.major} / {EDUCATION.cnMajor}</p>
                    </div>
                </div>
            </section>

            <section class="case-content-section">
                <div class="case-section-heading">
                    <p>Skills</p>
                    <h2>專業技能</h2>
                </div>
                <div class="about-skill-groups">
                    {[
                        { label: "Programming", items: SKILLS.programming },
                        { label: "Tools & Software", items: SKILLS.tools },
                        { label: "Professional", items: SKILLS.softSkills },
                    ].map((group) => (
                        <div class="about-skill-group">
                            <p class="case-kicker">{group.label}</p>
                            <div class="case-quick-meta">
                                {group.items.map((skill) => (
                                    <span>{skill}</span>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </section>

            <section class="case-content-section">
                <div class="case-section-heading">
                    <p>Experience</p>
                    <h2>經歷</h2>
                </div>
                <div class="about-panel-list">
                    {EXPERIENCE.map((exp) => (
                        <article class="about-panel about-panel--experience">
                            <span>{exp.date}</span>
                            <strong>{exp.title}</strong>
                            {exp.cnTitle && <p class="about-panel-cn">{exp.cnTitle}</p>}
                            {exp.company && <p class="about-panel-org">{exp.company}</p>}
                            {exp.event && <p class="about-panel-org">{exp.event}</p>}
                            <p>{exp.description}</p>
                            {exp.details.length > 0 && (
                                <ul>
                                    {exp.details.map((detail) => (
                                        <li>{detail}</li>
                                    ))}
                                </ul>
                            )}
                        </article>
                    ))}
                </div>
            </section>
        </main>

        <footer class="case-footer">
            <a href="/" class="case-back-link">
                <span class="case-back-icon" aria-hidden="true">
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="m12 19-7-7 7-7"></path>
                        <path d="M19 12H5"></path>
                    </svg>
                </span>
                <span>Back to Works</span>
            </a>
            <span>&copy; {new Date().getFullYear()} {PROFILE.name}.</span>
        </footer>
    </article>
</Layout>
