---
import "@/styles/globals.css";
import { ClientRouter } from "astro:transitions";
import GoldenGrid from "@/components/GoldenGrid.astro";
import { buildGoldenCells, resolvePreset } from "@/lib/goldenGrid";

interface Props {
    title: string;
    description?: string;
    image?: string;
    /** 黃金格線的 preset（見 src/lib/goldenGrid.ts 的 GOLDEN_PRESETS）。 */
    grid?: string;
    /** 這一頁的重點色，格線與背景動態都會吃這個值。 */
    accent?: string;
}

const {
    title,
    description = "Visual designer / Founder of STUDIO SORAI",
    image = "/og-image.png",
    grid = "minimal",
    accent = "#5ddcff",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.url);
// 換頁轉場的遮罩本體＝可見的那組黃金比例方格。用同一份資料算，
// 座標與大小才會完全對齊（有大有小，不是均分格）。
const flipCells = buildGoldenCells(resolvePreset(grid));

---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/jpeg" href="/favico.jpg" />
        <link rel="apple-touch-icon" href="/favico.jpg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>

        <meta name="title" content={title} />
        <meta name="description" content={description} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageURL} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={socialImageURL} />

        <!-- Preload Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;600;700;900&family=Space+Grotesk:wght@300;400;500;600;700;900&display=optional"
            rel="stylesheet"
        />
        <ClientRouter />

        <script is:inline>
            const getThemePreference = () => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                return window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light";
            };

            const setDarkClass = () => {
                const isDark = getThemePreference() === "dark";
                document.documentElement.classList[isDark ? "add" : "remove"](
                    "dark",
                );
            };

            // Initial setting
            setDarkClass();

            // ClientRouter 換頁時會用新文件的 <html> 屬性整組覆蓋，
            // 執行期加上的 dark class 不在靜態 HTML 裡，所以會被抹掉，
            // 換頁後一律變成亮色。after-swap 在繪製前觸發，在這裡補回去
            // 才不會閃一下。document 物件在 SPA 換頁中不會被替換，
            // 所以這個 listener 只需要註冊一次。
            if (!window.__portfolioThemeHooked) {
                window.__portfolioThemeHooked = true;
                document.addEventListener("astro:after-swap", setDarkClass);
            }

            /**
             * 換頁轉場：借用深淺切換那顆圓形擴散，但不動主題。
             *
             * 這樣做同時解掉「格線沉到背景那一刻很突兀」——切換期間方格會
             * 交出 view-transition-name，整頁連同格線由同一個圓形擴散帶過，
             * 圖層變化發生在擴散裡面，看不到單獨的跳動。
             */
            if (!window.__portfolioPageWipeHooked) {
                window.__portfolioPageWipeHooked = true;

                let wipeOrigin = null;
                let wipeActive = false;

                // 跟 dark class 同一個病因：ClientRouter 換頁時用新文件的
                // <html> 屬性整組覆蓋，data-page-wipe 會被沖掉，CSS 失效，
                // root 的預設淡入淡出就跑回來跟 clip-path 擴散打架。
                document.addEventListener("astro:after-swap", () => {
                    if (wipeActive) {
                        document.documentElement.dataset.pageWipe = "true";
                    }
                });

                // 記下點擊位置當擴散圓心；鍵盤／上一頁沒有座標就用畫面中心
                document.addEventListener(
                    "click",
                    (event) => {
                        if (!event.target || !event.target.closest) return;
                        const link = event.target.closest("a[href]");
                        wipeOrigin =
                            link && event.clientX
                                ? { x: event.clientX, y: event.clientY }
                                : null;
                    },
                    true,
                );

                // 覆蓋層的方格：依離點擊處的距離排先後，近的先翻掉
                const primeCells = (origin) => {
                    const layer = document.getElementById("page-flip");
                    if (!layer) return null;
                    const cells = layer.querySelectorAll(".page-flip__cell");
                    // 座標一定要夾在視窗內：鍵盤操作、或連結本身在畫面外時，
                    // clientX/Y 可能是負的或遠超過視窗高度，
                    // 圓心跑出去會讓半徑與每格的延遲全部算爆。
                    const clamp = (v, max) => Math.min(Math.max(v, 0), max);
                    const x = origin
                        ? clamp(origin.x, window.innerWidth)
                        : window.innerWidth / 2;
                    const y = origin
                        ? clamp(origin.y, window.innerHeight)
                        : window.innerHeight / 2;
                    const far = Math.hypot(window.innerWidth, window.innerHeight);
                    cells.forEach((cell) => {
                        const r = cell.getBoundingClientRect();
                        const d = Math.hypot(
                            r.left + r.width / 2 - x,
                            r.top + r.height / 2 - y,
                        );
                        cell.style.setProperty("--pf-d", `${Math.round((d / far) * 420)}ms`);
                    });
                    layer.style.setProperty("--pf-x", `${x}px`);
                    layer.style.setProperty("--pf-y", `${y}px`);
                    layer.style.setProperty(
                        "--pf-r",
                        `${Math.hypot(
                            Math.max(x, window.innerWidth - x),
                            Math.max(y, window.innerHeight - y),
                        )}px`,
                    );
                    return layer;
                };

                const PF_SPREAD_MS = 520;
                const prefersReduced = () =>
                    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

                // 旗標放在 closure，不放 <html> dataset——ClientRouter 換頁時
                // 會用新文件的 <html> 屬性整組覆蓋，dataset 會被沖掉。
                let flipPending = false;

                // 擴散要跑完才換頁，否則 swap 會在半路把它切斷。
                // before-preparation 的 loader 可以包起來延後。
                document.addEventListener("astro:before-preparation", (event) => {
                    if (document.documentElement.dataset.themeSwitching) return;
                    if (prefersReduced()) return;

                    const layer = primeCells(wipeOrigin);
                    if (!layer) return;

                    flipPending = true;
                    layer.classList.remove("is-covered", "is-flipping");
                    layer.classList.add("is-spreading");

                    const original = event.loader;
                    event.loader = async () => {
                        await original();
                        await new Promise((resolve) =>
                            window.setTimeout(resolve, PF_SPREAD_MS),
                        );
                    };
                });

                document.addEventListener("astro:before-swap", (event) => {
                    const transition = event.viewTransition;
                    const root = document.documentElement;
                    if (!transition) return;
                    if (root.dataset.themeSwitching) return;

                    wipeActive = true;
                    root.dataset.pageWipe = "true";
                    if (flipPending) root.dataset.pageFlip = "spread";

                    // 覆蓋層接手整段演出後，view transition 的動畫被 CSS 停用，
                    // 這顆 promise 會以 AbortError / InvalidStateError 被 reject。
                    // 沒人接就會變成 unhandled rejection，每導覽一次噴一次。
                    transition.ready.catch(() => {});
                    transition.updateCallbackDone?.catch(() => {});

                    transition.finished
                        .catch(() => {})
                        .finally(() => {
                            wipeActive = false;
                            delete root.dataset.pageWipe;
                            wipeOrigin = null;
                        });
                });

                // swap 之後接手新文件裡的同一層覆蓋層。此刻它已經是全滿的色板，
                // 所以接縫看不出來；接著方格帶著這個色板做 3D 翻面並淡出，
                // 露出底下原本色板的新頁。
                document.addEventListener("astro:after-swap", () => {
                    const root = document.documentElement;
                    if (!flipPending) return;

                    // dataset 被新文件覆蓋掉了，要重新標上，
                    // 否則停用 view-transition 動畫的 CSS 會失效。
                    root.dataset.pageFlip = "spread";

                    const layer = primeCells(wipeOrigin);
                    if (!layer) {
                        flipPending = false;
                        delete root.dataset.pageFlip;
                        return;
                    }

                    layer.classList.remove("is-spreading");
                    layer.classList.add("is-covered");

                    // 用 timeout 不用 requestAnimationFrame：頁面若在背景分頁
                    // （或視窗被收合），rAF 會整個停住，這一段就永遠不會開始。
                    // 只是要讓瀏覽器先畫出「已蓋滿」那一格，timeout 就夠了。
                    window.setTimeout(() => {
                        layer.classList.add("is-flipping");
                    }, 32);

                    window.setTimeout(() => {
                        layer.classList.remove("is-covered", "is-flipping");
                        flipPending = false;
                        delete root.dataset.pageFlip;
                    }, 1500);
                });
            }
        </script>
    </head>
    <body
        class="min-h-screen bg-background font-sans antialiased text-foreground overflow-x-hidden"
    >
        <svg
            class="portfolio-distortion-defs"
            aria-hidden="true"
            focusable="false"
            width="0"
            height="0"
        >
            <!-- 水波場與轉場共用同一顆濾鏡：canvas 波場、轉場水位線都套這個 -->
            <filter
                id="water-refraction"
                x="-12%"
                y="-12%"
                width="124%"
                height="124%"
                color-interpolation-filters="sRGB"
            >
                <feTurbulence
                    type="fractalNoise"
                    baseFrequency="0.009 0.016"
                    numOctaves="2"
                    seed="7"
                    result="waterNoise"
                />
                <feDisplacementMap
                    in="SourceGraphic"
                    in2="waterNoise"
                    scale="14"
                    xChannelSelector="R"
                    yChannelSelector="G"
                />
            </filter>
        </svg>
        <canvas id="water-field" aria-hidden="true" transition:persist></canvas>
        <div id="ambient-particles" aria-hidden="true"></div>
        <div class="portfolio-click-lens" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
        </div>
        <GoldenGrid preset={grid} accent={accent} />

        <!-- 換頁轉場的色板覆蓋層。標記必須寫在 Layout，新舊兩份文件才都有它，
             swap 之後才能無縫接著把方格翻掉。平常完全不佔畫面。 -->
        <div id="page-flip" class="page-flip" aria-hidden="true">
            {
                flipCells.map((cell) => (
                    <span
                        class="page-flip__cell"
                        style={`left:${cell.x}%;top:${cell.y}%;width:${cell.size}%;--pf-i:${cell.index}`}
                    />
                ))
            }
        </div>

        <div id="page-content">
            <slot />
        </div>
        <script src="../scripts/portfolio-interactions.js"></script>
    </body>
</html>

<style is:global>
    :root {
        --font-sans: "Space Grotesk", "Noto Sans TC", sans-serif;
    }
    body {
        font-family: var(--font-sans);
    }
</style>
