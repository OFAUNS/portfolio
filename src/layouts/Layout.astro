---
import "@/styles/globals.css";

interface Props {
    title: string;
    description?: string;
    image?: string;
}

const {
    title,
    description = "Visual designer / Founder of STUDIO SORAI",
    image = "/og-image.png",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.url);
const barbaNamespace =
    Astro.url.pathname === "/"
        ? "home"
        : Astro.url.pathname.replace(/^\/|\/$/g, "").replace(/[^a-z0-9]+/gi, "-") ||
          "page";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/jpeg" href="/favico.jpg" />
        <link rel="apple-touch-icon" href="/favico.jpg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>

        <meta name="title" content={title} />
        <meta name="description" content={description} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageURL} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={socialImageURL} />

        <!-- Preload Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;600;700;900&family=Space+Grotesk:wght@300;400;500;600;700;900&display=optional"
            rel="stylesheet"
        />
        <script is:inline>
            const getThemePreference = () => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                return window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light";
            };

            const setDarkClass = () => {
                const isDark = getThemePreference() === "dark";
                document.documentElement.classList[isDark ? "add" : "remove"](
                    "dark",
                );
            };

            // Initial setting
            setDarkClass();
        </script>
    </head>
    <body
        class="min-h-screen bg-background font-sans antialiased text-foreground overflow-x-hidden"
    >
        <svg
            class="portfolio-distortion-defs"
            aria-hidden="true"
            focusable="false"
            width="0"
            height="0"
        >
            <!-- 水波場與轉場共用同一顆濾鏡：canvas 波場、轉場水位線都套這個 -->
            <filter
                id="water-refraction"
                x="-12%"
                y="-12%"
                width="124%"
                height="124%"
                color-interpolation-filters="sRGB"
            >
                <feTurbulence
                    type="fractalNoise"
                    baseFrequency="0.009 0.016"
                    numOctaves="2"
                    seed="7"
                    result="waterNoise"
                />
                <feDisplacementMap
                    in="SourceGraphic"
                    in2="waterNoise"
                    scale="14"
                    xChannelSelector="R"
                    yChannelSelector="G"
                />
            </filter>
        </svg>
        <canvas id="water-field" aria-hidden="true"></canvas>
        <div id="ambient-particles" aria-hidden="true"></div>
        <div class="portfolio-click-lens" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
        </div>
        <div class="transition-overlay" aria-hidden="true">
            <div class="transition-overlay__base"></div>
            <div class="transition-overlay__caustics"></div>
            <div class="transition-overlay__speedcopy">
                <span>OFAUNS / MOTION / WEB / INTERACTION</span>
                <span>OFAUNS / MOTION / WEB / INTERACTION</span>
            </div>
            <div class="transition-overlay__mark">
                <span>OFAUNS</span>
            </div>
        </div>
        <div data-barba="wrapper">
            <div
                id="page-content"
                data-barba="container"
                data-barba-namespace={barbaNamespace}
            >
                <slot />
            </div>
        </div>
        <script src="../scripts/portfolio-interactions.js"></script>
    </body>
</html>

<style is:global>
    :root {
        --font-sans: "Space Grotesk", "Noto Sans TC", sans-serif;
    }
    body {
        font-family: var(--font-sans);
    }
</style>
