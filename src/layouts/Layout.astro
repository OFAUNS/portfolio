---
import "@/styles/globals.css";
import { ClientRouter } from "astro:transitions";
import GoldenGrid from "@/components/GoldenGrid.astro";

interface Props {
    title: string;
    description?: string;
    image?: string;
    /** 黃金格線的 preset（見 src/lib/goldenGrid.ts 的 GOLDEN_PRESETS）。 */
    grid?: string;
    /** 這一頁的重點色，格線與背景動態都會吃這個值。 */
    accent?: string;
}

const {
    title,
    description = "Visual designer / Founder of STUDIO SORAI",
    image = "/og-image.png",
    grid = "minimal",
    accent = "#5ddcff",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(image, Astro.url);
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/jpeg" href="/favico.jpg" />
        <link rel="apple-touch-icon" href="/favico.jpg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>

        <meta name="title" content={title} />
        <meta name="description" content={description} />

        <!-- Open Graph / Facebook -->
        <meta property="og:type" content="website" />
        <meta property="og:url" content={Astro.url} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageURL} />

        <!-- Twitter -->
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={Astro.url} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={socialImageURL} />

        <!-- Preload Fonts -->
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;600;700;900&family=Space+Grotesk:wght@300;400;500;600;700;900&display=optional"
            rel="stylesheet"
        />
        <ClientRouter />

        <script is:inline>
            const getThemePreference = () => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                return window.matchMedia("(prefers-color-scheme: dark)").matches
                    ? "dark"
                    : "light";
            };

            const setDarkClass = () => {
                const isDark = getThemePreference() === "dark";
                document.documentElement.classList[isDark ? "add" : "remove"](
                    "dark",
                );
            };

            // Initial setting
            setDarkClass();

            // ClientRouter 換頁時會用新文件的 <html> 屬性整組覆蓋，
            // 執行期加上的 dark class 不在靜態 HTML 裡，所以會被抹掉，
            // 換頁後一律變成亮色。after-swap 在繪製前觸發，在這裡補回去
            // 才不會閃一下。document 物件在 SPA 換頁中不會被替換，
            // 所以這個 listener 只需要註冊一次。
            if (!window.__portfolioThemeHooked) {
                window.__portfolioThemeHooked = true;
                document.addEventListener("astro:after-swap", setDarkClass);
            }

            /**
             * 換頁轉場：借用深淺切換那顆圓形擴散，但不動主題。
             *
             * 這樣做同時解掉「格線沉到背景那一刻很突兀」——切換期間方格會
             * 交出 view-transition-name，整頁連同格線由同一個圓形擴散帶過，
             * 圖層變化發生在擴散裡面，看不到單獨的跳動。
             */
            if (!window.__portfolioPageWipeHooked) {
                window.__portfolioPageWipeHooked = true;

                let wipeOrigin = null;
                let wipeActive = false;

                // 跟 dark class 同一個病因：ClientRouter 換頁時用新文件的
                // <html> 屬性整組覆蓋，data-page-wipe 會被沖掉，CSS 失效，
                // root 的預設淡入淡出就跑回來跟 clip-path 擴散打架。
                document.addEventListener("astro:after-swap", () => {
                    if (wipeActive) {
                        document.documentElement.dataset.pageWipe = "true";
                    }
                });

                // 記下點擊位置當擴散圓心；鍵盤／上一頁沒有座標就用畫面中心
                document.addEventListener(
                    "click",
                    (event) => {
                        if (!event.target || !event.target.closest) return;
                        const link = event.target.closest("a[href]");
                        wipeOrigin =
                            link && event.clientX
                                ? { x: event.clientX, y: event.clientY }
                                : null;
                    },
                    true,
                );

                document.addEventListener("astro:before-swap", (event) => {
                    const transition = event.viewTransition;
                    const root = document.documentElement;
                    if (!transition) return;

                    // 主題切換自己有一套演出，不要疊上來
                    if (root.dataset.themeSwitching) return;

                    wipeActive = true;
                    root.dataset.pageWipe = "true";

                    transition.ready
                        .then(() => {
                            const x = wipeOrigin
                                ? wipeOrigin.x
                                : window.innerWidth / 2;
                            const y = wipeOrigin
                                ? wipeOrigin.y
                                : window.innerHeight / 2;
                            const radius = Math.hypot(
                                Math.max(x, window.innerWidth - x),
                                Math.max(y, window.innerHeight - y),
                            );

                            root.animate(
                                {
                                    clipPath: [
                                        `circle(0px at ${x}px ${y}px)`,
                                        `circle(${radius}px at ${x}px ${y}px)`,
                                    ],
                                },
                                {
                                    duration: 700,
                                    easing: "cubic-bezier(0.22, 0.61, 0.36, 1)",
                                    pseudoElement: "::view-transition-new(root)",
                                },
                            );
                        })
                        .catch(() => {});

                    transition.finished
                        .catch(() => {})
                        .finally(() => {
                            wipeActive = false;
                            delete root.dataset.pageWipe;
                            wipeOrigin = null;
                        });
                });
            }
        </script>
    </head>
    <body
        class="min-h-screen bg-background font-sans antialiased text-foreground overflow-x-hidden"
    >
        <svg
            class="portfolio-distortion-defs"
            aria-hidden="true"
            focusable="false"
            width="0"
            height="0"
        >
            <!-- 水波場與轉場共用同一顆濾鏡：canvas 波場、轉場水位線都套這個 -->
            <filter
                id="water-refraction"
                x="-12%"
                y="-12%"
                width="124%"
                height="124%"
                color-interpolation-filters="sRGB"
            >
                <feTurbulence
                    type="fractalNoise"
                    baseFrequency="0.009 0.016"
                    numOctaves="2"
                    seed="7"
                    result="waterNoise"
                />
                <feDisplacementMap
                    in="SourceGraphic"
                    in2="waterNoise"
                    scale="14"
                    xChannelSelector="R"
                    yChannelSelector="G"
                />
            </filter>
        </svg>
        <canvas id="water-field" aria-hidden="true" transition:persist></canvas>
        <div id="ambient-particles" aria-hidden="true"></div>
        <div class="portfolio-click-lens" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
        </div>
        <GoldenGrid preset={grid} accent={accent} />

        <div id="page-content">
            <slot />
        </div>
        <script src="../scripts/portfolio-interactions.js"></script>
    </body>
</html>

<style is:global>
    :root {
        --font-sans: "Space Grotesk", "Noto Sans TC", sans-serif;
    }
    body {
        font-family: var(--font-sans);
    }
</style>
